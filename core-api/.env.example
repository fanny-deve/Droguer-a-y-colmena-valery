# Conexión a Supabase con el rol de mínimos privilegios (NO use el usuario postgres)
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=app_backend.jbotctjnyqpjsvpwezcm
DB_PASSWORD=
# Mínimo 32 caracteres aleatorios
JWT_SECRET=
# Solo se usa si no existe ninguna administradora (primer arranque); se exige cambiarla al ingresar
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_NOMBRE=Administradora
ANALYTICS_URL=http://localhost:8000
ANALYTICS_API_KEY=
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
# Redis Cloud (opcional). Si REDIS_ENABLED=false o Redis no responde, el sistema funciona igual, sin caché.
REDIS_ENABLED=false
REDIS_URL=rediss://default:CLAVE@HOST:PUERTO
